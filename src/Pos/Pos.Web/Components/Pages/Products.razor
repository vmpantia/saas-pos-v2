@page "/"
@page "/products"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionService Session
@inject ToastService Toasts

<PageTitle>Products - POS</PageTitle>

<div class="mx-auto max-w-6xl space-y-6">
    <PageHeader Title="Products" Description="@Subtitle">
        <Actions>
            <div class="w-full sm:w-72">
                <SearchInput @bind-Value="Search" Placeholder="Search name, SKU or category" />
            </div>
            <Button Variant="ButtonVariant.Outline" Loading="_loading" OnClick="LoadAsync"><Icon Name="refresh" /> Refresh</Button>
            <Button OnClick="() => _creating = true"><Icon Name="plus" /> New product</Button>
        </Actions>
    </PageHeader>

    @if (!_loading && _error is null)
    {
        <div class="grid gap-4 sm:grid-cols-3">
            <StatCard Title="Total products" Value="@_products.Count.ToString()" IconName="package" />
            <StatCard Title="Active" Value="@_products.Count(p => p.IsActive).ToString()" IconName="check" />
            <StatCard Title="Uncategorized" Value="@_products.Count(p => p.Category is null).ToString()" IconName="alert" />
        </div>
    }

    @if (!_loading && _error is null)
    {
        <Tabs Value="@_status" ValueChanged="SetStatus">
            <TabsList>
                <TabsTrigger Value="all">All</TabsTrigger>
                <TabsTrigger Value="active">Active</TabsTrigger>
                <TabsTrigger Value="inactive">Inactive</TabsTrigger>
            </TabsList>
        </Tabs>
    }

    @if (_loading)
    {
        <TableSkeleton />
    }
    else if (_error is not null)
    {
        <ErrorAlert Error="_error" OnRetry="LoadAsync" />
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Title="@(string.IsNullOrWhiteSpace(_search) ? "No products found" : "No matching products")"
                    Description="@(string.IsNullOrWhiteSpace(_search) ? "Products you add will appear here." : "Try a different search term.")" />
    }
    else
    {
        <Table>
            <TableHeader>
                <TableRow Class="hover:bg-transparent">
                    <TableHead>SKU</TableHead>
                    <TableHead>Name</TableHead>
                    <TableHead>Category</TableHead>
                    <TableHead Align="TextAlign.Right">Price</TableHead>
                    <TableHead Align="TextAlign.Right">Cost</TableHead>
                    <TableHead Align="TextAlign.Right">Reorder level</TableHead>
                    <TableHead>Status</TableHead>
                    <TableHead Align="TextAlign.Right">Actions</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var product in Paged)
                {
                    <TableRow @key="product.Id">
                        <TableCell Class="font-mono text-xs text-muted-foreground">@product.Sku</TableCell>
                        <TableCell Class="font-medium">@product.Name</TableCell>
                        <TableCell Class="text-muted-foreground">@(product.Category?.Name ?? "-")</TableCell>
                        <TableCell Align="TextAlign.Right" Class="tabular-nums">@product.Price.ToString("N2")</TableCell>
                        <TableCell Align="TextAlign.Right" Class="tabular-nums text-muted-foreground">@product.Cost.ToString("N2")</TableCell>
                        <TableCell Align="TextAlign.Right" Class="tabular-nums text-muted-foreground">@product.ReorderLevel</TableCell>
                        <TableCell><StatusBadge IsActive="product.IsActive" /></TableCell>
                        <TableCell Align="TextAlign.Right">
                            <DropdownMenu>
                                <Trigger><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" aria-label="Actions"><Icon Name="more" /></Button></Trigger>
                                <ChildContent>
                                    <DropdownMenuItem OnClick="() => _viewId = product.Id"><Icon Name="eye" /> View</DropdownMenuItem>
                                    <DropdownMenuItem OnClick="() => _editing = product"><Icon Name="pencil" /> Edit</DropdownMenuItem>
                                    <Separator Class="my-1" />
                                    <DropdownMenuItem Destructive="product.IsActive" OnClick="() => AskToggle(product)"><Icon Name="@(product.IsActive ? "ban" : "check")" /> @(product.IsActive ? "Deactivate" : "Activate")</DropdownMenuItem>
                                </ChildContent>
                            </DropdownMenu>
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
        <Pagination Page="_page" PageChanged="SetPage" PageSize="PageSize" Total="Filtered.Count" />
    }
    @if (_creating)
    {
        <ProductFormDialog OnSaved="OnSavedAsync" OnClose="CloseDialogs" />
    }
    else if (_editing is not null)
    {
        <ProductFormDialog Product="_editing" OnSaved="OnSavedAsync" OnClose="CloseDialogs" />
    }
    else if (_viewId is not null)
    {
        <ProductDetailsDialog ProductId="_viewId.Value" OnClose="CloseDialogs" />
    }
    else if (_toggling is not null)
    {
        <ConfirmDialog Title="@(_toggling.IsActive ? "Deactivate " : "Activate ")"
                       Description="@(_toggling.IsActive ? $"'{_toggling.Name}' will be marked inactive." : $"'{_toggling.Name}' will be marked active again.")"
                       ConfirmText="@(_toggling.IsActive ? "Deactivate" : "Activate")" Destructive="_toggling.IsActive"
                       Busy="_busy" Error="_toggleError" OnConfirm="ConfirmToggleAsync" OnCancel="CloseDialogs" />
    }
</div>

@code {
    private List<ProductDto> _products = [];
    private ApiError? _error;
    private bool _loading = true;
    private string? _search = string.Empty;

    private List<ProductDto> Matching => string.IsNullOrWhiteSpace(_search)
        ? _products
        : _products.Where(p =>
            p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            (p.Category?.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private const int PageSize = 10;

    private string _status = "all";
    private int _page = 1;

    private string? Search
    {
        get => _search;
        set
        {
            _search = value;
            _page = 1;
        }
    }

    private List<ProductDto> Filtered => _status switch
    {
        "active" => Matching.Where(x => x.IsActive).ToList(),
        "inactive" => Matching.Where(x => !x.IsActive).ToList(),
        _ => Matching
    };

    private IEnumerable<ProductDto> Paged => Filtered.Skip((_page - 1) * PageSize).Take(PageSize);

    private void SetStatus(string status)
    {
        _status = status;
        _page = 1;
    }

    private void SetPage(int page) => _page = page;
    private string Subtitle => _loading || _error is not null
        ? "Browse your product catalog."
        : $"{Filtered.Count} of {_products.Count} products";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Api.GetProductsAsync();
        if (result.IsSuccess)
        {
            _products = result.Value!;
        }
        else if (!await Session.HandleUnauthorizedAsync(result.Error))
        {
            _error = result.Error;
        }

        _page = Math.Min(_page, Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize)));
        _loading = false;
    }

    private ProductDto? _editing;
    private ProductDto? _toggling;
    private Guid? _viewId;
    private bool _creating;
    private bool _busy;
    private ApiError? _toggleError;

    private void CloseDialogs()
    {
        _creating = false;
        _editing = null;
        _viewId = null;
        _toggling = null;
        _toggleError = null;
    }

    private Task OnSavedAsync(ProductDto saved)
    {
        Toasts.Success(_editing is null ? "Product created" : "Product updated", saved.Name);
        CloseDialogs();
        return LoadAsync();
    }

    private void AskToggle(ProductDto item)
    {
        _toggleError = null;
        _toggling = item;
    }

    private async Task ConfirmToggleAsync()
    {
        _busy = true;
        _toggleError = null;

        var result = await Api.SetProductActiveAsync(_toggling!.Id, !_toggling.IsActive);
        _busy = false;

        if (result.IsSuccess)
        {
            Toasts.Success(result.Value!.IsActive ? "Product activated" : "Product deactivated", result.Value.Name);
            CloseDialogs();
            await LoadAsync();
        }
        else if (!await Session.HandleUnauthorizedAsync(result.Error))
        {
            _toggleError = result.Error;
        }
    }
}
