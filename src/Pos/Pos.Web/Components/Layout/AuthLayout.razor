@inherits LayoutComponentBase

<main class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 py-12">
    <div class="flex items-center gap-3">
        <div class="flex size-10 items-center justify-center rounded-md bg-primary text-primary-foreground">
            <Icon Name="bag" Class="size-6" />
        </div>
        <span class="text-2xl font-semibold tracking-tight">POS</span>
    </div>
    <div class="w-full max-w-sm">
        @Body
    </div>
</main>

<Toaster />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
