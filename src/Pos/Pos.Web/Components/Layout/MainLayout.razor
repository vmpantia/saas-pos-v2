@inherits LayoutComponentBase
@inject SessionService Session

<div class="flex min-h-screen">
    <aside class="sticky top-0 hidden h-screen w-64 shrink-0 flex-col border-r border-sidebar-border bg-sidebar/70 text-sidebar-foreground backdrop-blur-xl md:flex">
        <div class="flex items-center gap-3 px-6 py-6">
            <div class="flex size-9 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-md shadow-primary/30">
                <Icon Name="bag" Class="size-5" />
            </div>
            <span class="text-lg font-semibold tracking-tight">POS</span>
        </div>
        <nav class="flex-1 space-y-1 px-3">
            <NavLink href="products" Match="NavLinkMatch.Prefix" class="@NavClass" ActiveClass="@ActiveClass">
                <Icon Name="package" /> Products
            </NavLink>
            <NavLink href="categories" Match="NavLinkMatch.Prefix" class="@NavClass" ActiveClass="@ActiveClass">
                <Icon Name="tag" /> Categories
            </NavLink>
        </nav>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-10 flex items-center justify-between border-b bg-card/70 px-4 py-3 backdrop-blur-xl sm:px-6">
            <nav class="flex gap-1 md:hidden">
                <NavLink href="products" Match="NavLinkMatch.Prefix" class="@NavClass" ActiveClass="@ActiveClass"><Icon Name="package" /> Products</NavLink>
                <NavLink href="categories" Match="NavLinkMatch.Prefix" class="@NavClass" ActiveClass="@ActiveClass"><Icon Name="tag" /> Categories</NavLink>
            </nav>
            <div class="hidden md:block"></div>

            <AuthorizeView>
                <Authorized>
                    <div class="flex items-center gap-3">
                        <div class="hidden text-right leading-tight sm:block">
                            <p class="text-sm font-medium">@context.User.Identity?.Name</p>
                            <p class="text-xs text-muted-foreground">@context.User.FindFirst("email")?.Value</p>
                        </div>
                        <div class="flex size-9 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
                            @Initials(context.User.Identity?.Name)
                        </div>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="Session.SignOutAsync">
                            <Icon Name="log-out" /> Sign out
                        </Button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="flex-1 p-4 sm:p-8">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private const string NavClass = "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground";
    private const string ActiveClass = "bg-sidebar-accent! text-sidebar-accent-foreground! shadow-xs";

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return name.Trim()[0].ToString().ToUpperInvariant();
    }
}
