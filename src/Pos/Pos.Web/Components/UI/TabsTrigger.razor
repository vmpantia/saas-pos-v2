@inherits UiComponent

<button type="button" role="tab" aria-selected="@(Active ? "true" : "false")" @onclick="() => Tabs!.SelectAsync(Value)"
        class="@Cn("inline-flex h-[calc(100%-1px)] cursor-pointer items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-transparent px-3 py-1 text-sm font-medium transition-[color,box-shadow] outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50",
                   Active ? "bg-background text-foreground shadow-sm" : "text-foreground/70 hover:text-foreground", Class)"
        @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [CascadingParameter] private Tabs? Tabs { get; set; }

    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    private bool Active => Tabs?.Value == Value;
}
