@inherits UiComponent

@* Render conditionally (@if) so the content's state resets each time it opens. *@
<div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50" @onclick="Close"></div>
    <div role="dialog" aria-modal="true" class="@Cn("relative z-10 flex max-h-[90vh] w-full flex-col rounded-lg border bg-background shadow-lg", Size, Class)" @attributes="AdditionalAttributes">
        <div class="flex items-start justify-between gap-4 border-b px-6 py-4">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold leading-none">@Title</h2>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="text-sm text-muted-foreground">@Description</p>
                }
            </div>
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="-mr-2 -mt-1" OnClick="Close" aria-label="Close"><Icon Name="x" /></Button>
        </div>
        <div class="overflow-y-auto px-6 py-4">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="flex flex-col-reverse gap-2 border-t px-6 py-4 sm:flex-row sm:justify-end">@Footer</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string Size { get; set; } = "max-w-lg";
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
