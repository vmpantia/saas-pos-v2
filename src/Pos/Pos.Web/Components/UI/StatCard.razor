@inherits UiComponent

<Card Class="@Cn("gap-3 py-5", Class)">
    <CardContent Class="flex items-center justify-between gap-4">
        <div class="grid gap-1">
            <p class="text-sm font-medium text-muted-foreground">@Title</p>
            <p class="text-2xl font-semibold tracking-tight tabular-nums">@Value</p>
        </div>
        <div class="flex size-10 items-center justify-center rounded-lg bg-muted text-muted-foreground">
            <Icon Name="@IconName" Class="size-5" />
        </div>
    </CardContent>
</Card>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string IconName { get; set; } = string.Empty;
}
