@inherits UiComponent

<span class="@Classes" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Default;

    private string Classes => Cn(
        "inline-flex w-fit shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-md border px-2 py-0.5 text-xs font-medium",
        Variant switch
        {
            BadgeVariant.Secondary => "border-transparent bg-secondary text-secondary-foreground",
            BadgeVariant.Destructive => "border-transparent bg-destructive text-white",
            BadgeVariant.Outline => "text-foreground",
            BadgeVariant.Success => "border-transparent bg-emerald-100 text-emerald-800",
            _ => "border-transparent bg-primary text-primary-foreground"
        },
        Class);
}
